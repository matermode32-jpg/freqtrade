# SAFE TEMPLATE ONLY - no real secrets here.
# Copy this file to .env locally if you need it, but NEVER commit .env.
# Real values go ONLY in Render Dashboard > Environment at deploy time.
# Code / entrypoint reads these names at runtime, so placeholders connect
# to the real API without ever exposing the real keys in git or chat.
#
# I will never open, read, display, or output your real .env file.

# Telegram (required now - get from @BotFather / getUpdates)
TELEGRAM_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Freqtrade API server (required for Render web service + keep-alive)
API_SERVER_USERNAME=freqtrader
API_SERVER_PASSWORD=your_api_password_here
API_SERVER_JWT_KEY=your_jwt_secret_here
API_SERVER_WS_TOKEN=your_ws_token_here
PORT=8080

# Binance (NOT needed for dry-run - leave empty for now)
EXCHANGE_KEY=
EXCHANGE_SECRET=

# Later only - master engine / posting LLM, Binance Square
OPENCODE_ZEN_KEY=
BINANCE_SQUARE_API_KEY=
