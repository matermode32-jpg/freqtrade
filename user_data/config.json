{
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "spot",
    "margin_mode": null,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_min": 1,
        "order_book_max": 1,
        "price_last_balance": 0.0,
        "use_order_book_timeframe": null,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_min": 1,
        "order_book_max": 1,
        "price_last_balance": 0.0,
        "use_order_book_timeframe": null,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exchange": {
        "name": "kraken",
        "enabled": true,
        "key": "",
        "secret": "",
        "markets_refresh_interval": 60,
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {
            "enableRateLimit": true
        },
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT"
        ],
        "pair_blacklist": [
            "DOGE/USDT",
            "SHIB/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "your_token_here",
        "chat_id": "your_chat_id_here",
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_fill": "on",
            "entry_cancel": "on",
            "exit": "on",
            "exit_fill": "on",
            "exit_cancel": "on",
            "protection_trigger": "on",
            "protection_trigger_global": "on"
        }
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "your_jwt_secret_here_make_it_long_32_plus_chars_1234567890",
        "username": "freqtrader",
        "password": "your_api_password_here",
        "ws_token": "your_ws_token_here"
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "timeframe": "5m",
    "strategy": "SampleStrategy",
    "strategy_path": "/freqtrade/user_data/strategies/",
    "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite",
    "user_data_dir": "/freqtrade/user_data",
    "verbosity": 0,
    "logfile": "/freqtrade/user_data/logs/freqtrade.log"
}
